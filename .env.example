APP_NAME="Carpintería El Tajibo"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=America/La_Paz
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_TIMEZONE=-04:00
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=carpinteria_el_tajibo
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_COOKIE=el_tajibo_session
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

MAIL_MAILER=log
MAIL_FROM_ADDRESS="sistema@example.test"
MAIL_FROM_NAME="${APP_NAME}"
VITE_APP_NAME="${APP_NAME}"

AUTH_PASSWORD_RESET_ENABLED=false

# En APP_ENV=local, migrate --seed incluye los ejemplos del proyecto.
# Descomenta para cargar únicamente catálogos, sin ejemplos:
# TAJIBO_DATOS_EJEMPLO=false
