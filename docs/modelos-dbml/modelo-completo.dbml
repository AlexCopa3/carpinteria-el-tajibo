Ref "model_has_permissions_permission_id_foreign":"permissions"."id" < "model_has_permissions"."permission_id" [delete: cascade]
Ref "model_has_roles_role_id_foreign":"roles"."id" < "model_has_roles"."role_id" [delete: cascade]
Ref "role_has_permissions_permission_id_foreign":"permissions"."id" < "role_has_permissions"."permission_id" [delete: cascade]
Ref "role_has_permissions_role_id_foreign":"roles"."id" < "role_has_permissions"."role_id" [delete: cascade]
Ref "materiales_unidad_id_foreign":"unidades_materiales"."id" < "materiales"."unidad_id" [delete: restrict]
Ref "materiales_categoria_id_foreign":"categorias"."id" < "materiales"."categoria_id" [delete: restrict]
Ref "existencias_materiales_material_id_foreign":"materiales"."id" - "existencias_materiales"."material_id" [delete: restrict]
Ref "movimientos_materiales_usuario_id_foreign":"users"."id" < "movimientos_materiales"."usuario_id" [delete: restrict]
Ref "movimientos_materiales_material_id_foreign":"materiales"."id" < "movimientos_materiales"."material_id" [delete: restrict]
