Project carpinteria_el_tajibo {
  database_type: 'MySQL'
}

Table "pedidos" {
  "id" bigint [pk, not null, increment]
  "cotizacion_id" bigint [not null]
  "cliente_id" bigint [not null]
  "datos_cliente_acordados" json [not null]
  "fecha_aceptacion" date [not null]
  "fecha_prevista_entrega" date
  "responsable_id" bigint
  "registrado_por_id" bigint [not null]
  "estado" varchar(30) [not null, default: "aceptado"]
  "version" int [not null, default: "1"]
  "cotizacion_aceptada_version" int [not null, default: "0"]
  "observaciones" text
  "precio_total_acordado" decimal(18,2) [not null]
  "clave_registro" char(36) [not null]
  "hash_solicitud" varchar(64) [not null]
  "created_at" timestamp
  "updated_at" timestamp
  "materiales_validados_por_id" bigint
  "materiales_validados_at" timestamp
  "precio_confirmado_por_id" bigint
  "precio_confirmado_at" timestamp

  Indexes {
    "cotizacion_id" [unique, name: 'pedidos_cotizacion_id_unique']
    "fecha_prevista_entrega" [name: 'pedidos_fecha_prevista_entrega_index']
    "estado" [name: 'pedidos_estado_index']
    "clave_registro" [unique, name: 'pedidos_clave_registro_unique']
  }
}

Table "detalles_pedido" {
  "id" bigint [pk, not null, increment]
  "pedido_id" bigint [not null]
  "detalle_cotizacion_id" bigint [not null]
  "posicion" int [not null]
  "cantidad_muebles" int [not null]
  "precio_acordado" decimal(18,2) [not null]
  "created_at" timestamp
  "updated_at" timestamp

  Indexes {
    ("pedido_id", "posicion") [unique, name: 'detalles_pedido_pedido_id_posicion_unique']
    "detalle_cotizacion_id" [unique, name: 'detalles_pedido_detalle_cotizacion_id_unique']
  }
}

Table "materiales_pedido" {
  "id" bigint [pk, not null, increment]
  "detalle_pedido_id" bigint [not null]
  "material_cotizacion_id" bigint
  "material_id" bigint [not null]
  "unidad_id" bigint [not null]
  "material_nombre" varchar(255) [not null]
  "unidad_nombre" varchar(60) [not null]
  "componente" varchar(100) [not null, default: "General"]
  "cantidad_inicial" decimal(18,4)
  "cantidad_planificada" decimal(18,4) [not null]
  "observaciones" text
  "actualizado_por_id" bigint [not null]
  "created_at" timestamp
  "updated_at" timestamp
  "cantidad_utilizada" decimal(18,4)
  "observaciones_uso" text
  "uso_registrado_por_id" bigint
  "uso_registrado_at" timestamp

  Indexes {
    "material_cotizacion_id" [unique, name: 'materiales_pedido_material_cotizacion_id_unique']
  }
}

Table "estados_pedido" {
  "id" bigint [pk, not null, increment]
  "pedido_id" bigint [not null]
  "estado_anterior" varchar(30)
  "estado_nuevo" varchar(30) [not null]
  "usuario_id" bigint [not null]
  "ocurrido_at" timestamp [not null]
  "motivo" text
  "version_resultante" int [not null]
  "clave_operacion" char(36) [not null]
  "hash_solicitud" varchar(64) [not null]
  "created_at" timestamp
  "updated_at" timestamp

  Indexes {
    ("pedido_id", "version_resultante") [unique, name: 'estados_pedido_pedido_id_version_resultante_unique']
    "clave_operacion" [unique, name: 'estados_pedido_clave_operacion_unique']
  }
}

Table "cotizaciones" {
  "id" bigint [pk, not null, increment]
  "clave_registro" char(36) [not null]
  "solicitud_hash" char(64) [not null]
  "cliente_id" bigint
  "responsable_id" bigint [not null]
  "fecha" date [not null]
  "estado" varchar(20) [not null, default: "borrador"]
  "version" int [not null, default: "1"]
  "observaciones" text
  "condiciones" text
  "costo_materiales" decimal(18,2)
  "costo_mano_obra" decimal(18,2) [not null, default: "0"]
  "otros_costos" decimal(18,2) [not null, default: "0"]
  "costo_total" decimal(18,2)
  "recargo_porcentaje" decimal(9,4)
  "precio_sugerido" decimal(18,2)
  "precio_final" decimal(18,2)
  "validado_por_id" bigint
  "validado_at" timestamp
  "aprobado_por_id" bigint
  "aprobado_at" timestamp
  "datos_cliente_aprobados" json
  "created_at" timestamp
  "updated_at" timestamp

  Indexes {
    ("estado", "fecha") [name: 'cotizaciones_estado_fecha_index']
    ("cliente_id", "fecha") [name: 'cotizaciones_cliente_id_fecha_index']
    "clave_registro" [unique, name: 'cotizaciones_clave_registro_unique']
  }
}

Table "detalles_cotizacion" {
  "id" bigint [pk, not null, increment]
  "cotizacion_id" bigint [not null]
  "posicion" int [not null]
