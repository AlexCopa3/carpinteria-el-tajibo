  "costo_total" decimal(18,2)
  "precio_propuesto" decimal(18,2)
  "precio_sugerido" decimal(18,2)
  "precio_final" decimal(18,2)
  "created_at" timestamp
  "updated_at" timestamp

  Indexes {
    ("cotizacion_id", "posicion") [unique, name: 'detalles_cotizacion_cotizacion_id_posicion_unique']
  }
}

Table "clientes" {
  "id" bigint [pk, not null, increment]
  "nombre" varchar(255) [not null]
