// Modelo generado del esquema declarado en las migraciones de Laravel.
// No contiene registros, credenciales ni cambios sobre MySQL.
// Las relaciones polimorficas de Spatie no se convierten en FK inexistentes.

Project carpinteria_el_tajibo {
  database_type: 'MySQL'
}

Table "casos_historicos" {
  "id" bigint [pk, not null, increment]
  "detalle_pedido_id" bigint
  "tipo_mueble_id" bigint [not null]
  "material_principal_id" bigint [not null]
  "tipo_nombre" varchar(80) [not null]
  "material_principal_nombre" varchar(255) [not null]
  "fecha_referencia" date [not null]
  "largo_cm" decimal(14,4) [not null]
  "ancho_cm" decimal(14,4) [not null]
  "alto_cm" decimal(14,4) [not null]
  "puertas" int [not null]
  "cajones" int [not null]
  "divisiones" int [not null]
  "acabado" varchar(150) [not null]
  "cantidad_muebles" int [not null]
  "descripcion" text
  "contexto" varchar(255)
  "origen" varchar(20) [not null]
  "fuente" varchar(30) [not null]
  "fuente_caracteristicas" varchar(40) [not null]
  "fuente_costos" varchar(40) [not null]
  "estado_revision" varchar(20) [not null, default: "pendiente"]
  "motivo_no_elegible" text
  "costo_materiales_estimado_total" decimal(18,2)
  "mano_obra_estimada_total" decimal(18,2) [not null]
  "otros_costos_estimados_total" decimal(18,2) [not null]
  "costo_estimado_total" decimal(18,2)
  "costo_presupuestado_total" decimal(18,2)
  "precio_historico_total" decimal(18,2) [not null]
  "lote" varchar(80)
  "posicion_lote" smallint
  "version" int [not null, default: "1"]
  "materiales_revisados_por_id" bigint
  "materiales_revisados_at" timestamp
  "precio_revisado_por_id" bigint
  "precio_revisado_at" timestamp
  "created_at" timestamp
  "updated_at" timestamp

  Indexes {
    ("lote", "posicion_lote") [unique, name: 'casos_historicos_lote_posicion_lote_unique']
    "detalle_pedido_id" [unique, name: 'casos_historicos_detalle_pedido_id_unique']
    "origen" [name: 'casos_historicos_origen_index']
    "estado_revision" [name: 'casos_historicos_estado_revision_index']
  }
}

Table "materiales_caso" {
  "id" bigint [pk, not null, increment]
  "caso_historico_id" bigint [not null]
  "posicion" int [not null]
  "material_pedido_id" bigint
  "material_id" bigint [not null]
  "unidad_id" bigint [not null]
  "material_nombre" varchar(255) [not null]
  "unidad_nombre" varchar(60) [not null]
  "componente" varchar(100) [not null, default: "General"]
  "cantidad_total" decimal(18,4) [not null]
  "costo_unitario_estimado" decimal(18,6)
  "subtotal_estimado" decimal(18,2)
  "fuente_costo" varchar(40) [not null]
  "created_at" timestamp
  "updated_at" timestamp

  Indexes {
    ("caso_historico_id", "posicion") [unique, name: 'materiales_caso_caso_historico_id_posicion_unique']
  }
}

Table "tipos_mueble" {
  "id" bigint [pk, not null, increment]
  "codigo" varchar(30) [not null]
  "nombre" varchar(80) [not null]
  "activo" tinyint(1) [not null, default: "1"]
  "created_at" timestamp
  "updated_at" timestamp

  Indexes {
    "codigo" [unique, name: 'tipos_mueble_codigo_unique']
  }
}

Table "materiales" {
  "id" bigint [pk, not null, increment]
  "nombre" varchar(255) [not null]
  "descripcion" text
  "categoria" varchar(100) [not null]
  "especificaciones" text
  "unidad_id" bigint [not null]
  "precio_referencia" decimal(18,6) [not null]
  "stock_minimo" decimal(18,4)
  "activo" tinyint(1) [not null, default: "1"]
  "created_at" timestamp
  "updated_at" timestamp
  "categoria_id" bigint

  Indexes {
    ("activo", "categoria") [name: 'materiales_activo_categoria_index']
  }
}

Table "unidades_materiales" {
  "id" bigint [pk, not null, increment]
  "codigo" varchar(20) [not null]
  "nombre" varchar(60) [not null]
  "fraccionaria" tinyint(1) [not null]
  "created_at" timestamp
  "updated_at" timestamp

  Indexes {
    "codigo" [unique, name: 'unidades_materiales_codigo_unique']
  }
}

Table "users" {
  "id" bigint [pk, not null, increment]
  "name" varchar(255) [not null]
  "email" varchar(255) [not null]
  "password_temporal" tinyint(1) [not null, default: "0"]
  "email_verified_at" timestamp
  "password" varchar(255) [not null]
  "activo" tinyint(1) [not null, default: "1"]
  "remember_token" varchar(100)
  "created_at" timestamp
  "updated_at" timestamp

  Indexes {
    "email" [unique, name: 'users_email_unique']
  }
}

Ref "materiales_unidad_id_foreign":"unidades_materiales"."id" < "materiales"."unidad_id" [delete: restrict]
Ref "casos_historicos_tipo_mueble_id_foreign":"tipos_mueble"."id" < "casos_historicos"."tipo_mueble_id" [delete: restrict]
Ref "casos_historicos_material_principal_id_foreign":"materiales"."id" < "casos_historicos"."material_principal_id" [delete: restrict]
Ref "casos_historicos_materiales_revisados_por_id_foreign":"users"."id" < "casos_historicos"."materiales_revisados_por_id" [delete: restrict]
Ref "casos_historicos_precio_revisado_por_id_foreign":"users"."id" < "casos_historicos"."precio_revisado_por_id" [delete: restrict]
Ref "materiales_caso_caso_historico_id_foreign":"casos_historicos"."id" < "materiales_caso"."caso_historico_id" [delete: restrict]
Ref "materiales_caso_material_id_foreign":"materiales"."id" < "materiales_caso"."material_id" [delete: restrict]
Ref "materiales_caso_unidad_id_foreign":"unidades_materiales"."id" < "materiales_caso"."unidad_id" [delete: restrict]
